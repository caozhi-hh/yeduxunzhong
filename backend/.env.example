# 野渡寻踪 后端环境变量模板
# 复制为 .env 后填值即可（.env 已在 .gitignore 里，不会进仓库）
# 注意：已存在的环境变量优先于本文件 —— HF Spaces 的 Secrets 不会被它覆盖。

# ==================== 图源（二选一，填 Pixabay 则自动优先）====================
# 【推荐】Pixabay：免费档 100 次/60 秒（= 6000/小时），是 Unsplash 免费档 50 次/小时的 120 倍；
# 且其条款要求「先把图片下载到服务器」→ 本项目落盘自托管，国内加载快、浏览器可缓存。
# 取值：https://pixabay.com/api/docs/ 登录后页面上直接显示 key，免费。
PIXABAY_API_KEY=

# Unsplash：免费（Demo）档只有 50 次/小时，实测用尽后 403 "Rate Limit Exceeded"，
# 一次推荐就花 8–15 次 → 很容易不够用。留空 PIXABAY_API_KEY 时会回退到它。
UNSPLASH_ACCESS_KEY=

# ==================== 对话模型（智谱 GLM）====================
# 免费档 glm-4-flash；旗舰 glm-5.2 额度在 Anthropic 端点，需充值
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/anthropic
CHAT_MODEL=glm-4-flash

# ==================== 其它 ====================
# 高德 Web 服务 key：用于地理编码；现有 key 已失效（USER_KEY_RECYCLED），需重新申请
AMAP_WEB_KEY=
# JWT 签名密钥：留空则用 backend/.jwt_secret 里自动生成的强随机值（已 gitignore）；
# 生产环境请显式配置，否则每次容器重建会导致用户被登出
JWT_SECRET=